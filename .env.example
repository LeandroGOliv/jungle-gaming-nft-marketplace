# Copie para .env.local para sobrescrever. Todos são opcionais.

# Base das chamadas REST (padrão: /api, interceptado pelo MSW).
VITE_API_URL=/api

# Origem do Socket.IO (padrão: a própria origem da aplicação).
VITE_SOCKET_URL=

# Caminho do Socket.IO (padrão: /realtime/).
VITE_SOCKET_PATH=/realtime/

# "false" desliga a camada de mocks (padrão: ligada).
VITE_ENABLE_MOCKS=true
